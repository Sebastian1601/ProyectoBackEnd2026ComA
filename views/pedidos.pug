doctype html
html(lang="es")
  include ./head
  link(rel="stylesheet" href="css/clientes.css")
  link(rel="stylesheet" href="css/productos.css")

  body
    include ./header

    a(href="./index", class="boton-volverInicio", target="_self") > Volver a inicio

    h2 Gestión de pedidos

    style.
      .producto-seleccionado {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        padding: 6px 10px;
        margin-bottom: 6px;
        background: var(--fondo);
        border: 1px solid var(--borde);
        border-radius: 6px;
        font-size: 0.9rem;
      }

      .boton-quitar {
        background: transparent;
        color: var(--peligro);
        border: 1px solid var(--peligro);
        border-radius: 4px;
        padding: 2px 8px;
        cursor: pointer;
        font-size: 0.8rem;
      }

      .boton-quitar:hover {
        background: var(--peligro);
        color: white;
      }

      .boton-agregar {
        margin-bottom: 12px;
        background: var(--fondo) !important;
        color: var(--acento) !important;
        border: 1px solid var(--acento) !important;
      }

      .boton-agregar:hover {
        background: var(--acento) !important;
        color: white !important;
      }

      .mensaje-pedido {
        margin-top: 10px;
        font-size: 0.85rem;
        font-weight: bold;
      }

    .main-clientes
      // PANEL IZQUIERDO
      .ingreso-clientes
        h3(style="margin-top: 0; margin-bottom: 1rem; font-size: 1.15rem; font-weight: 600; color: var(--texto);") Realizar pedido

        form#formPedido
          .campo
            label(for="clientePedido") Cliente
            select#clientePedido(required)
              option(value="") Seleccionar cliente
              each cliente in clientes
                option(value=cliente._id)= cliente.nombre

          .campo(style="margin-top: 0.85rem;")
            label(for="productoPedido") Producto
            select#productoPedido
              option(value="") Seleccionar producto
              each producto in productos
                option(value=producto.nombre)= producto.nombre

          button#agregarProducto.boton-agregar(type="button" style="margin-top: 0.85rem; width: 100%;") + Agregar producto

          label(style="font-weight: 600; font-size: 0.85rem; color: var(--texto-suave); display: block; margin-bottom: 0.3rem;") Productos seleccionados
          #listaProductos(style="min-height: 40px; margin-bottom: 0.85rem;")
            p(style="font-size: 0.85rem; color: var(--texto-suave); margin: 0.3rem 0;") Todavía no agregaste productos.

          button#guardarPedido(type="submit" style="width: 100%;") Guardar pedido

          p#mensajePedido.mensaje-pedido(role="status" aria-live="polite")

      // PANEL DERECHO
      .listado-clientes
        .header-listado-clientes
          h2 Pedidos realizados

        .main-listado-clientes
          table#tabla-clientes
            thead
              tr
                th N°
                th Cliente
                th Fecha
                th Productos
                th Estado
                th Acciones

            tbody
              if pedidos && pedidos.length
                each pedido, index in pedidos
                  tr
                    td= index + 1
                    td= pedido.idCliente ? pedido.idCliente.nombre : 'Cliente no asignado'
                    td= pedido.fecha ? new Date(pedido.fecha).toLocaleDateString('es-AR') : 'S/D'
                    td= pedido.productos ? pedido.productos.join(', ') : 'Sin productos'
                    td= pedido.estado
                    td
                      button.eliminar(
                        type="button"
                        data-id=pedido._id.toString()
                      ) Eliminar
              else
                tr
                  td(colspan="6") No hay pedidos registrados

        p#mensajeEliminar.mensaje-pedido(role="status" aria-live="polite")

    script.
      const productosSeleccionados = [];

      const selectorProducto = document.getElementById("productoPedido");
      const listaProductos = document.getElementById("listaProductos");
      const mensajePedido = document.getElementById("mensajePedido");
      const botonGuardar = document.getElementById("guardarPedido");
      const mensajeEliminar = document.getElementById("mensajeEliminar");

      function mostrarProductos() {
        listaProductos.replaceChildren();

        if (productosSeleccionados.length === 0) {
          const texto = document.createElement("p");
          texto.style.fontSize = "0.85rem";
          texto.style.color = "var(--texto-suave)";
          texto.style.margin = "0.3rem 0";
          texto.textContent = "Todavía no agregaste productos.";
          listaProductos.appendChild(texto);
          return;
        }

        productosSeleccionados.forEach((producto, indice) => {
          const fila = document.createElement("div");
          fila.className = "producto-seleccionado";

          const nombre = document.createElement("span");
          nombre.textContent = producto;

          const quitar = document.createElement("button");
          quitar.type = "button";
          quitar.className = "boton-quitar";
          quitar.textContent = "Quitar";

          quitar.addEventListener("click", () => {
            productosSeleccionados.splice(indice, 1);
            mostrarProductos();
          });

          fila.append(nombre, quitar);
          listaProductos.appendChild(fila);
        });
      }

      document.getElementById("agregarProducto").addEventListener("click", () => {
        const producto = selectorProducto.value;

        if (!producto) {
          mensajePedido.textContent = "Seleccioná un producto.";
          return;
        }

        productosSeleccionados.push(producto);
        selectorProducto.value = "";
        mensajePedido.textContent = "";
        mostrarProductos();
      });

      document.getElementById("formPedido").addEventListener("submit", async (evento) => {
        evento.preventDefault();

        const idCliente = document.getElementById("clientePedido").value;

        if (!idCliente || productosSeleccionados.length === 0) {
          mensajePedido.textContent = "Seleccioná un cliente y agregá productos.";
          return;
        }

        botonGuardar.disabled = true;
        mensajePedido.textContent = "Guardando pedido...";

        try {
          const respuesta = await fetch("/apiV1/pedidos", {
            method: "POST",
            credentials: "same-origin",
            headers: {
              "Content-Type": "application/json"
            },
            body: JSON.stringify({
              idCliente: idCliente,
              productos: productosSeleccionados,
              estado: "Pendiente"
            })
          });

          const resultado = await respuesta.json().catch(() => ({}));

          if (!respuesta.ok) {
            throw new Error(
              resultado.error ||
              resultado.mensaje ||
              "No se pudo guardar el pedido."
            );
          }

          mensajePedido.textContent = "Pedido creado correctamente.";
          window.location.reload();

        } catch (error) {
          mensajePedido.textContent = error.message;
        } finally {
          botonGuardar.disabled = false;
        }
      });

      // ELIMINAR PEDIDOS
      document.querySelectorAll(".eliminar").forEach((boton) => {
        boton.addEventListener("click", async () => {
          const idPedido = boton.dataset.id;

          const confirmar = window.confirm(
            "¿Estás seguro de que querés eliminar este pedido? Esta acción no se puede deshacer."
          );

          if (!confirmar) {
            return;
          }

          boton.disabled = true;
          mensajeEliminar.textContent = "Eliminando pedido...";

          try {
            const respuesta = await fetch(
              "/apiV1/pedidos/" + encodeURIComponent(idPedido),
              {
                method: "DELETE",
                credentials: "same-origin"
              }
            );

            const resultado = await respuesta.json().catch(() => ({}));

            if (!respuesta.ok) {
              throw new Error(
                resultado.error ||
                resultado.mensaje ||
                "No se pudo eliminar el pedido."
              );
            }

            mensajeEliminar.textContent = "Pedido eliminado correctamente.";
            window.location.reload();

          } catch (error) {
            mensajeEliminar.textContent = error.message;
            boton.disabled = false;
          }
        });
      });

    include ./footer
