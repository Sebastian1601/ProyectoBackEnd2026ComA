doctype html 
html(lang="es")
    include ./head 
    link(rel="stylesheet" href="css/clientes.css")

    body 
      include ./header
      a(href="./index", class="boton-volverInicio", target='_self') Volver a inicio
      .main-clientes 
        .tabla-container
          table#tablaClientes
            caption Lista de choferes
            thead
              tr
                th Nombre
                th Estado
                th Vehículo asignado
            tbody
              each chofer in choferes
                tr
                  td= chofer.nombre + ' ' + chofer.apellido
                  td= chofer.estado
                  td= chofer.idVehiculoAsignado || 'Sin asignar'
      include ./footer
