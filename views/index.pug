doctype html
html(lang="es")
  include ./head
  link(rel="stylesheet" href="./css/index.css")
  script(type="module" src="./js/index.js" defer)
  body
    include ./header

    main.contenedor
      h2 Bienvenidos

      p Aplicación desarrollada para la gestión de clientes, pedidos, vehículos, choferes y rutas de FreshRoute B2B.

      .tarjetas
        .tarjeta
          a(href="./clientes")
            h3 Clientes
            p Administración de los clientes registrados.

        .tarjeta
          a(href="./pedidos")
            h3 Pedidos
            p Registro y seguimiento de pedidos.

        .tarjeta
          a(href="./vehiculos")
            h3 Vehículos
            p Gestión de los vehículos disponibles.

        .tarjeta
          a(href="/choferes")
            h3 Choferes
            p Administración y asignación de choferes.

        .tarjeta
          a(href="./rutas")
            h3 Rutas
            p Organización de rutas y entregas.

    include ./footer
      