doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    link(rel="stylesheet" href="./css/index.css")
    title FreshRoute B2B
  body
    header
      h1 FreshRoute B2B
      p Sistema de Gestión Logística

    main.contenedor
      h2 Bienvenidos

      p Aplicación desarrollada para la gestión de clientes, pedidos, vehículos, choferes y rutas de FreshRoute B2B.

      .tarjetas
        .tarjeta
          h3 Clientes
          p Administración de los clientes registrados.

        .tarjeta
          h3 Pedidos
          p Registro y seguimiento de pedidos.

        .tarjeta
          h3 Vehículos
          p Gestión de los vehículos disponibles.

        .tarjeta
          h3
            a(href="/choferes/ver-choferes") Choferes
          p Administración y asignación de choferes.

        .tarjeta
          h3 Rutas
          p Organización de rutas y entregas.

    footer
      p Desarrollo Web Backend - Primera Entrega 2026