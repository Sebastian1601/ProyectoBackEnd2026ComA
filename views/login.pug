//- login.pug
//- Vista de login básica para Node.js (Express + Pug).
//- Renderizar con: res.render('login')
//- El form no hace submit tradicional: el JS del final intercepta
//- el evento y hace el fetch contra tu endpoint propio.
doctype html
html(lang="es")
  include ./head
  script(type="module" src="./js/login.js" defer)
  link(rel="stylesheet" href="./css/login.css")
  body
    include ./header
    main
      .login-box
        h1 Inicie sesión
        form#login-form
          .field
            label(for="username") Usuario
            input#username(type="text" name="username" autocomplete="username" required)
          .field
            label(for="password") Contraseña
            input#password(type="password" name="password" autocomplete="current-password" required)
          button(type="submit") Ingresar
          p#login-error
    include ./footer